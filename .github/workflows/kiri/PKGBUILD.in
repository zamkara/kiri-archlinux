# Generated by kiri-archlinux-workflow from an immutable upstream commit.
pkgname=kiri
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc=@DESCRIPTION@
arch=('x86_64')
url=@URL@
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'systemd' 'pacman' 'polkit' 'gtk3' 'webkit2gtk-4.1'
         'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('rust' 'cargo' 'pkgconf' 'python' 'gtk3' 'webkit2gtk-4.1'
             'desktop-file-utils')
optdepends=('docker: an existing Docker CLI keeps precedence on PATH'
            'wl-clipboard: persistent Wayland clipboard support')
provides=('kiri')
conflicts=('kiri-lite' 'kiri-bin' 'kiri-git')
options=('!lto' '!debug' '!strip')
_commit=@SHA@
_upstream_version=@UPSTREAM_VERSION@
_build_date=@BUILD_DATE@
_arch_repo=@REPOSITORY@
_docker_ver=@DOCKER_VER@
_compose_ver=@COMPOSE_VER@
_buildx_ver=@BUILDX_VER@
source=(@SOURCES@)
sha256sums=(@CHECKSUMS@)

_build_env() {
  export CARGO_HOME="$startdir/.cache/cargo"
  export CARGO_BUILD_JOBS="${KIRI_BUILD_JOBS:-2}"
  export CARGO_PROFILE_RELEASE_DEBUG=0
  export RUSTFLAGS='-C target-cpu=x86-64 -C linker-features=-lld'
}

prepare() {
  cd "$srcdir/kiri-$_commit"
  python "$startdir/patch_updater.py" . "$_arch_repo"
  sed -i "0,/^version = \"0\.0\.0\"/s//version = \"$_upstream_version\"/" Cargo.toml
  sed -i "s/^version = \"0\.0\.0\"$/version = \"$_upstream_version\"/" Cargo.lock
}

build() {
  cd "$srcdir/kiri-$_commit"
  _build_env
  CARGO_TARGET_DIR="$startdir/.cache/target-engine" \
    cargo build --release --locked -p kiri -p kiri-init
  CARGO_TARGET_DIR="$startdir/.cache/target-window" \
    cargo build --release --locked -p kiri --features window
}

check() {
  cd "$srcdir/kiri-$_commit"
  _build_env
  test -x "$startdir/.cache/target-engine/release/kiri"
  test -x "$startdir/.cache/target-engine/release/kiri-init"
  test -x "$startdir/.cache/target-window/release/kiri"
  grep -aq "kiri/$_upstream_version" "$startdir/.cache/target-engine/release/kiri"
  grep -aq "kiri/$_upstream_version" "$startdir/.cache/target-window/release/kiri"
  "$srcdir/docker/docker" --version >/dev/null
  chmod +x "$srcdir/docker-compose-$_compose_ver" "$srcdir/docker-buildx-$_buildx_ver"
  "$srcdir/docker-compose-$_compose_ver" version >/dev/null
  "$srcdir/docker-buildx-$_buildx_ver" version >/dev/null
}

package() {
  cd "$srcdir/kiri-$_commit"
  _build_env
  local size file

  install -Dm755 "$startdir/.cache/target-engine/release/kiri" "$pkgdir/usr/bin/kiri"
  install -Dm755 "$startdir/.cache/target-engine/release/kiri-init" "$pkgdir/usr/bin/kiri-init"
  install -Dm755 "$startdir/.cache/target-window/release/kiri" "$pkgdir/usr/lib/kiri/kiri-window"

  printf '{"repository":"%s","pkgver":"%s","pkgrel":%s,"version":"%s-%s","commit":"%s"}\n' \
    "$_arch_repo" "$pkgver" "$pkgrel" "$pkgver" "$pkgrel" "$_commit" \
    > "$pkgdir/usr/lib/kiri/arch-release.json"
  chmod 644 "$pkgdir/usr/lib/kiri/arch-release.json"

  install -Dm644 packaging/linux/kiri.service "$pkgdir/usr/lib/systemd/system/kiri.service"
  install -Dm644 packaging/linux/dev.kiri.host-access.policy \
    "$pkgdir/usr/share/polkit-1/actions/dev.kiri.host-access.policy"

  install -Dm755 "$srcdir/docker/docker" "$pkgdir/usr/libexec/kiri/bin/docker"
  install -Dm755 packaging/linux/docker-wrapper "$pkgdir/usr/libexec/kiri/docker"
  install -Dm755 "$srcdir/docker-compose-$_compose_ver" \
    "$pkgdir/usr/libexec/kiri/cli-plugins/docker-compose"
  install -Dm755 "$srcdir/docker-buildx-$_buildx_ver" \
    "$pkgdir/usr/libexec/kiri/cli-plugins/docker-buildx"

  cat > "$pkgdir/usr/lib/kiri/docker-links.sh" <<'LINKS'
#!/usr/bin/env bash
set -euo pipefail
docker_slot_free() {
  [[ ! -e /usr/bin/docker && ! -L /usr/bin/docker ]] && return 0
  [[ $(readlink /usr/bin/docker 2>/dev/null || true) == /usr/libexec/kiri/docker ]]
}
plugin_slot_free() {
  local name=$1 d
  for d in /usr/local/lib/docker/cli-plugins /usr/local/libexec/docker/cli-plugins /usr/libexec/docker/cli-plugins; do
    [[ -e $d/$name ]] && return 1
  done
  local link=/usr/lib/docker/cli-plugins/$name
  [[ ! -e $link && ! -L $link ]] && return 0
  [[ $(readlink "$link" 2>/dev/null || true) == /usr/libexec/kiri/cli-plugins/$name ]]
}
if [[ -x /usr/libexec/kiri/docker ]]; then
  if docker_slot_free; then
    ln -sfn /usr/libexec/kiri/docker /usr/bin/docker
  fi
  mkdir -p /usr/lib/docker/cli-plugins
  for p in docker-compose docker-buildx; do
    if plugin_slot_free "$p"; then
      ln -sfn "/usr/libexec/kiri/cli-plugins/$p" "/usr/lib/docker/cli-plugins/$p"
    elif [[ $(readlink "/usr/lib/docker/cli-plugins/$p" 2>/dev/null || true) == /usr/libexec/kiri/cli-plugins/$p ]]; then
      rm -f "/usr/lib/docker/cli-plugins/$p"
    fi
  done
else
  if [[ $(readlink /usr/bin/docker 2>/dev/null || true) == /usr/libexec/kiri/docker ]]; then
    rm -f /usr/bin/docker
  fi
  for p in docker-compose docker-buildx; do
    if [[ $(readlink "/usr/lib/docker/cli-plugins/$p" 2>/dev/null || true) == /usr/libexec/kiri/cli-plugins/$p ]]; then
      rm -f "/usr/lib/docker/cli-plugins/$p"
    fi
  done
fi
LINKS
  chmod 755 "$pkgdir/usr/lib/kiri/docker-links.sh"

  install -d "$pkgdir/usr/share/libalpm/hooks"
  cat > "$pkgdir/usr/share/libalpm/hooks/95-kiri-docker-links.hook" <<'HOOK'
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/libexec/kiri/docker
Target = usr/bin/docker
Target = usr/lib/docker/cli-plugins/*
Target = usr/libexec/docker/cli-plugins/*

[Action]
Description = Updating Kiri Docker CLI links...
When = PostTransaction
Exec = /bin/sh -c 'if [ -x /usr/lib/kiri/docker-links.sh ]; then /usr/lib/kiri/docker-links.sh; else [ "$(readlink /usr/bin/docker 2>/dev/null)" != /usr/libexec/kiri/docker ] || rm -f /usr/bin/docker; for p in docker-compose docker-buildx; do [ "$(readlink /usr/lib/docker/cli-plugins/$p 2>/dev/null)" != /usr/libexec/kiri/cli-plugins/$p ] || rm -f /usr/lib/docker/cli-plugins/$p; done; fi'
HOOK

  install -Dm644 contrib/linux/kiri.desktop "$pkgdir/usr/share/applications/kiri.desktop"
  desktop-file-validate "$pkgdir/usr/share/applications/kiri.desktop"

  install -d "$pkgdir/usr/share/metainfo"
  sed -e "s/@VERSION@/$_upstream_version/g" -e "s/@DATE@/$_build_date/g" \
    contrib/linux/dev.kiri.Kiri.metainfo.xml \
    > "$pkgdir/usr/share/metainfo/dev.kiri.Kiri.metainfo.xml"

  for size in 16 32 64 128 256 512; do
    install -Dm644 "brand/icon/png/kiri-app-icon-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/kiri.png"
  done
  install -Dm644 brand/icon/kiri-app-icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/kiri.svg"

  install -d "$pkgdir/usr/lib/sysusers.d"
  printf 'g kiri - -\n' > "$pkgdir/usr/lib/sysusers.d/kiri.conf"

  for file in LICENSE NOTICE; do
    [[ ! -f "$file" ]] || install -Dm644 "$file" "$pkgdir/usr/share/licenses/$pkgname/$file"
  done
  [[ ! -f README.md ]] || install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
